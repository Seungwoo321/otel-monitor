{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OTel Monitor",
  "version": "0.3.0",
  "identifier": "dev.seungwoo.otel-monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OTel Monitor",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Seungwoo321/otel-monitor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0MzJCQjI3NTA4RkJBMkUKUldRdXVvOVFKN3N5OUVJWjVVeUh4TEQveXVrY1BqRElveS9sbEhiUEZsemVDdlFVNlErS1ZDSHMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}